  "cards": [
    {
      "dot": "cyan",
      "title": "Una base por servicio",
      "items": [
        "Nueve bases: en desarrollo un contenedor PostgreSQL, en produccion nueve instancias",
        "La regla la impone el motor, no el equipo: sin GRANT cruzado",
        "El JOIN entre contextos se pierde y se recupera en ms-reportes"
      ]
    },
    {
      "dot": "emerald",
      "title": "Solo stock y credito frenan una venta",
      "items": [
        "Criticas: inventario 500 ms, credito 800 ms",
        "Degradables: promociones y clientes 300 ms, la venta sigue",
        "SUNAT caida: el comprobante queda PENDIENTE y la caja sigue cobrando"
      ]
    },
    {
      "dot": "rose",
      "title": "Saga, outbox e idempotencia",
      "items": [
        "Confirmar venta: transaccion local mas un evento en outbox",
        "Reservar stock: un update condicional atomico por (producto, local)",
        "Idempotency-Key en Redis: el reintento del POS no cobra dos veces"
      ]
    }
  ]
