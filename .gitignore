# ---------------------------------------------------------------------------
# Secretos. Lo primero de la lista a proposito.
# ---------------------------------------------------------------------------
# El .env lleva la clave de Postgres y el par RSA con el que
# ms-identidad firma los JWT. La plantilla .env.example SI se versiona: sin ella
# nadie sabe que variables hacen falta.
.env
.env.*
!.env.example

# Claves y certificados sueltos, por si alguien las deja fuera del .env.
*.pem
*.key
*.p12
*.jks
*.keystore

# ---------------------------------------------------------------------------
# Instrucciones para el asistente de codigo
# ---------------------------------------------------------------------------
# Configuracion de una herramienta, no del sistema. Se queda en local.
CLAUDE.md
.claude/

# ---------------------------------------------------------------------------
# Compilacion
# ---------------------------------------------------------------------------
# Maven: un target por cada uno de los trece modulos del reactor.
target/

# El wrapper SI se versiona (mvnw, mvnw.cmd y .mvn/wrapper), que es el punto de
# tenerlo: clonar y compilar sin instalar Maven antes.

# Frontend
node_modules/
dist/
.vite/
*.tsbuildinfo

# ---------------------------------------------------------------------------
# Ejecucion local
# ---------------------------------------------------------------------------
*.log
logs/
npm-debug.log*
yarn-error.log*

# Volumenes y volcados de Postgres si alguien los saca a la carpeta del proyecto.
*.sql.gz
*.dump
pgdata/

# ---------------------------------------------------------------------------
# Salidas de herramientas de documentacion
# ---------------------------------------------------------------------------
graphify-out/
archify-out/

# ---------------------------------------------------------------------------
# Editores y sistema operativo
# ---------------------------------------------------------------------------
.idea/
*.iml
*.iws
*.ipr
.vscode/
.settings/
.classpath
.project
.factorypath

.DS_Store
Thumbs.db
desktop.ini
