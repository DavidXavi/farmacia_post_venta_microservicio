# Copiar a .env y completar. El .env NO se versiona.
# En produccion esto no existe: los secretos van en Vault o en Secrets de Kubernetes.

# Postgres. Un solo contenedor con nueve bases; esta clave es la del superusuario
# y tambien la que reciben los nueve usuarios de servicio.
POSTGRES_USER=postgres
DB_PASSWORD=cambia-esta-clave

# RabbitMQ (perfil completo): cola de emision de comprobantes.
RABBITMQ_USER=posfarmacia
RABBITMQ_PASSWORD=cambia-esta-clave

# Firma de los JWT que emite ms-identidad. Par RSA en PEM, una sola linea con \n.
# Generarlo con: ./scripts/generar-claves-jwt.sh
JWT_CLAVE_PRIVADA=
JWT_CLAVE_PUBLICA=

# Login social. Sin credenciales reales los botones existen pero el proveedor rechaza.
GOOGLE_CLIENT_ID=sin-configurar
GOOGLE_CLIENT_SECRET=sin-configurar
FACEBOOK_CLIENT_ID=sin-configurar
FACEBOOK_CLIENT_SECRET=sin-configurar

# SUNAT. "mock" levanta un simulador con latencia y fallas; para el ambiente real
# de pruebas de SUNAT, poner aqui la URL del OSE.
SUNAT_URL=mock

# Puertos del host. Solo hace falta tocarlos si ya tienes algo en el 8080 o el 5175.
# GATEWAY_PORT=8080
# FRONTEND_API_URL=http://localhost:8080
# FRONTEND_URL=http://localhost:5175

# Grafana (perfil observabilidad)
GRAFANA_PASSWORD=admin
